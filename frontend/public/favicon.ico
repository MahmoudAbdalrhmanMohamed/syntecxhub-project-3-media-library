<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">
  <defs>
    <linearGradient id="irisGrad1" x1="10" y1="10" x2="54" y2="54" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#FB7185" />
      <stop offset="50%" stop-color="#E11D48" />
      <stop offset="100%" stop-color="#9F1239" />
    </linearGradient>
    <linearGradient id="irisGrad2" x1="54" y1="10" x2="10" y2="54" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#F472B6" />
      <stop offset="50%" stop-color="#D946EF" />
      <stop offset="100%" stop-color="#86198F" />
    </linearGradient>
    <radialGradient id="apertureGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="60%" stop-color="#F43F5E" />
      <stop offset="100%" stop-color="#881337" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- Dark base backing -->
  <rect width="64" height="64" rx="14" fill="#0B0612" />
  <rect width="64" height="64" rx="14" stroke="#E11D48" stroke-width="1.5" stroke-opacity="0.3" fill="none" />

  <!-- Outer Aperture Ring -->
  <circle cx="32" cy="32" r="22" stroke="url(#irisGrad2)" stroke-width="2" stroke-opacity="0.5" stroke-dasharray="3 3" />

  <!-- Dynamic Aperture Blades -->
  <!-- Blade 1 -->
  <path d="M32 12 C38 20 42 26 44 32 L34 32 Z" fill="url(#irisGrad1)" opacity="0.9" />
  <!-- Blade 2 -->
  <path d="M48 20 C46 30 44 36 38 42 L33 34 Z" fill="url(#irisGrad2)" opacity="0.9" />
  <!-- Blade 3 -->
  <path d="M48 44 C40 46 34 44 26 42 L30 33 Z" fill="url(#irisGrad1)" opacity="0.9" />
  <!-- Blade 4 -->
  <path d="M32 52 C26 44 22 38 20 32 L30 32 Z" fill="url(#irisGrad2)" opacity="0.9" />
  <!-- Blade 5 -->
  <path d="M16 44 C18 34 20 28 26 22 L31 30 Z" fill="url(#irisGrad1)" opacity="0.9" />
  <!-- Blade 6 -->
  <path d="M16 20 C24 18 30 20 38 22 L34 31 Z" fill="url(#irisGrad2)" opacity="0.9" />

  <!-- Center Focal Sparkle -->
  <circle cx="32" cy="32" r="4.5" fill="url(#apertureGlow)" />
  <circle cx="32" cy="32" r="2" fill="#FFFFFF" />
</svg>
